{
  "name": "@gemini-mail/backend",
  "version": "1.0.0",
  "description": "Backend del cliente de correo Gemini Mail",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "node dist/scripts/migrate.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "setup": "node scripts/setup-check.js",
    "setup:linux": "chmod +x setup.sh && ./setup.sh",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File setup.ps1",
    "verify": "node scripts/verify-installation.js",
    "postinstall": "node scripts/setup-check.js",
    "db:migrate": "psql -U postgres -d gemini_mail -f src/scripts/init-db.sql",
    "db:reset": "psql -U postgres -c 'DROP DATABASE IF EXISTS gemini_mail' && psql -U postgres -c 'CREATE DATABASE gemini_mail' && npm run db:migrate",
    "generate:env": "node scripts/generate-env.js",
    "generate:key": "node -e \"console.log('PASSWORD_ENCRYPTION_KEY=' + require('crypto').randomBytes(32).toString('hex'))\"",
    "logs:clean": "rm -rf logs/*.log",
    "logs:tail": "tail -f logs/combined.log",
    "redis:start": "redis-server",
    "redis:cli": "redis-cli",
    "queue:stats": "node scripts/queue-stats.js"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.4.0",
    "@google/generative-ai": "^0.21.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.66.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "googleapis": "^144.0.0",
    "imap": "^0.8.19",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mailparser": "^3.7.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.13",
    "openpgp": "^5.11.2",
    "pg": "^8.11.5",
    "redis": "^4.6.13",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/imap": "^0.8.40",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/luxon": "^3.7.1",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}

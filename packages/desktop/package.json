{
  "name": "@gemini-mail/desktop",
  "version": "1.0.0",
  "description": "Gemini Mail Desktop Application",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:electron\"",
    "dev:backend": "cd ../backend && npm run dev",
    "dev:electron": "NODE_ENV=development tsx watch src/main-enhanced.ts",
    "build": "tsc && electron-builder",
    "build:win": "tsc && electron-builder --win",
    "build:linux": "tsc && electron-builder --linux",
    "build:mac": "tsc && electron-builder --mac",
    "build:all": "tsc && electron-builder --win --linux --mac",
    "package": "electron-builder --dir",
    "start": "electron .",
    "clean": "rm -rf dist release"
  },
  "build": {
    "appId": "com.geminimail.app",
    "productName": "Gemini Mail",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gemini Mail"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "concurrently": "^8.2.2",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}

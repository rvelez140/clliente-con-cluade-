# Configuración de ejemplo de Nginx para Gemini Mail
# Copia este archivo a /etc/nginx/sites-available/gemini-mail
# y ajusta según tus necesidades

server {
    listen 80;
    listen [::]:80;

    server_name tu-dominio.com www.tu-dominio.com;

    # Logs
    access_log /var/log/nginx/gemini-mail-access.log;
    error_log /var/log/nginx/gemini-mail-error.log;

    # Tamaño máximo de subida (para archivos adjuntos)
    client_max_body_size 50M;

    # Frontend - React App
    location / {
        proxy_pass http://127.0.0.1:80;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Backend API
    location /api {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts para operaciones largas (ej: procesamiento de emails)
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Bloquear acceso directo a archivos sensibles
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}


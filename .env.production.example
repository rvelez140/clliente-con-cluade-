# ============================================
# Gemini Mail - Production Environment
# ============================================
# Copia este archivo como .env y configura los valores
# Los secretos NO van aquí, usa ./scripts/setup-secrets.sh

# ============================================
# INFRASTRUCTURE
# ============================================

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=gemini_mail
DB_USER=gemini_user
# DB_PASSWORD se lee desde /run/secrets/db_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD se lee desde /run/secrets/redis_password

# ============================================
# APPLICATION
# ============================================

# Node Environment
NODE_ENV=production

# Backend Configuration
BACKEND_PORT=3000
BACKEND_EXPOSE_PORT=127.0.0.1:3000

# Frontend Configuration
FRONTEND_PORT=80
FRONTEND_EXPOSE_PORT=127.0.0.1:8080

# Trust proxy (necesario cuando se usa Nginx)
TRUST_PROXY=true

# ============================================
# SECURITY
# ============================================

# JWT Configuration
# JWT_SECRET se lee desde /run/secrets/jwt_secret

# CORS Configuration (cambiar por tu dominio)
CORS_ORIGIN=https://tu-dominio.com

# ============================================
# EXTERNAL SERVICES
# ============================================

# Gemini AI
# GEMINI_API_KEY se lee desde /run/secrets/gemini_api_key

# Gmail OAuth2 (Opcional)
GMAIL_CLIENT_ID=
GMAIL_REDIRECT_URI=https://tu-dominio.com/api/oauth/gmail/callback
# GMAIL_CLIENT_SECRET se lee desde /run/secrets/gmail_client_secret

# Microsoft OAuth2 (Opcional)
MICROSOFT_CLIENT_ID=
MICROSOFT_REDIRECT_URI=https://tu-dominio.com/api/oauth/microsoft/callback
# MICROSOFT_CLIENT_SECRET se lee desde /run/secrets/microsoft_client_secret

# ============================================
# BACKUPS
# ============================================

# Número de días a mantener backups
BACKUP_RETENTION_DAYS=7

# ============================================
# MONITORING & LOGGING
# ============================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ============================================
# NOTES
# ============================================
#
# 1. Todos los secretos se manejan con Docker Secrets
# 2. Ejecuta ./scripts/setup-secrets.sh para configurar secretos
# 3. No incluyas contraseñas o API keys en este archivo
# 4. Para desarrollo local, puedes usar .env con valores de prueba
# 5. En producción, asegúrate de cambiar CORS_ORIGIN a tu dominio real
